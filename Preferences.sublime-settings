{
	"ignored_packages": [
		"Vintage",
	],
	"font_size": 13,
	"index_files": true,
	"font_face": "JetBrainsMonoNL Nerd Font Mono",
	"theme": "auto",
	"dark_theme": "Default Dark.sublime-theme",
	"light_theme": "Default.sublime-theme",
	"color_scheme": "auto",
	"dark_color_scheme": "Monokai.sublime-color-scheme",
	"light_color_scheme": "Breakers.sublime-color-scheme",
	"ensure_newline_at_eof_on_save": true,
	"trim_trailing_white_space_on_save": "not_on_caret",
	"save_on_focus_lost": true,
	"atomic_save": false,
	"drag_text": false,
	"scroll_past_end": 0.5,
	"highlight_line": true,
	"match_brackets_content": true,
	"binary_file_patterns": [
		"*.pyc",
		"*.so",
		"node_modules/*",
		".venv/*",
		"__pycache__/*",
		"*.min.js"
	],
	"file_exclude_patterns": [
		".DS_Store",
		"*.pyc",
		"*.lock"
	],
	"folder_exclude_patterns": [
		".git",
		"__pycache__",
		".venv",
		"venv",
		".mypy_cache",
		".ruff_cache",
		"node_modules",
		".tox",
		"dist",
		"build"
	],
}
